{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/motor.js": { "maxDuration": 60 },
    "api/render.*": { "maxDuration": 60 },
    "api/agent.*": { "maxDuration": 60 },
    "api/calcular-orcamento.*": { "maxDuration": 30 },
    "api/analisar-planta.*": { "maxDuration": 30 },
    "api/pdf-orcamento.*": { "maxDuration": 30 },
    "api/vision.*": { "maxDuration": 30 },
    "api/ai.*": { "maxDuration": 30 },
    "api/lista-corte.*": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
