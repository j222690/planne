# Worker de render 3D — copie para .env e preencha.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=   # SERVICE ROLE (server-side); nunca a anon
RENDER_BUCKET=renders3d

# Blender headless
BLENDER_BIN=blender
RENDER_ENGINE=eevee
RENDER_W=1600
RENDER_H=900

# Fila
POLL_INTERVAL_S=3
MAX_TENTATIVAS=3
